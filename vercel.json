{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-homepage.js && node scripts/perf.js && node scripts/seo-files.js",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "data/{preturi,brand,intrebari-status,observatii-status}.json"
    }
  },
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/manage/legaturi",
      "destination": "/manage/sinapse",
      "permanent": false
    },
    {
      "source": "/manage/legaturi/",
      "destination": "/manage/sinapse/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/nou/index.html"
    },
    {
      "source": "/vechi",
      "destination": "/site/index.html"
    },
    {
      "source": "/vechi/",
      "destination": "/site/index.html"
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/site/wp-content/:path*"
    },
    {
      "source": "/wp-includes/:path*",
      "destination": "/site/wp-includes/:path*"
    },
    {
      "source": "/nou",
      "destination": "/nou/index.html"
    },
    {
      "source": "/nou/",
      "destination": "/nou/index.html"
    },
    {
      "source": "/nou/medici/:id",
      "destination": "/nou/medici/:id/index.html"
    },
    {
      "source": "/nou/medici/:id/",
      "destination": "/nou/medici/:id/index.html"
    },
    {
      "source": "/nou/tratamente/:cat/:id",
      "destination": "/nou/tratamente/:cat/:id/index.html"
    },
    {
      "source": "/nou/tratamente/:cat/:id/",
      "destination": "/nou/tratamente/:cat/:id/index.html"
    },
    {
      "source": "/nou/consultatii",
      "destination": "/nou/consultatii/index.html"
    },
    {
      "source": "/nou/consultatii/",
      "destination": "/nou/consultatii/index.html"
    },
    {
      "source": "/nou/consultatii/:id",
      "destination": "/nou/consultatii/:id/index.html"
    },
    {
      "source": "/nou/consultatii/:id/",
      "destination": "/nou/consultatii/:id/index.html"
    },
    {
      "source": "/nou/preturi",
      "destination": "/nou/preturi/index.html"
    },
    {
      "source": "/nou/preturi/",
      "destination": "/nou/preturi/index.html"
    },
    {
      "source": "/nou/video",
      "destination": "/nou/video/index.html"
    },
    {
      "source": "/nou/video/",
      "destination": "/nou/video/index.html"
    },
    {
      "source": "/nou/blog",
      "destination": "/nou/blog/index.html"
    },
    {
      "source": "/nou/blog/",
      "destination": "/nou/blog/index.html"
    },
    {
      "source": "/nou/longevitate/program",
      "destination": "/nou/longevitate/program/index.html"
    },
    {
      "source": "/nou/longevitate/program/",
      "destination": "/nou/longevitate/program/index.html"
    },
    {
      "source": "/nou/:slug",
      "destination": "/nou/:slug/index.html"
    },
    {
      "source": "/nou/:slug/",
      "destination": "/nou/:slug/index.html"
    },
    {
      "source": "/api/entitati",
      "destination": "/data/entitati.json"
    },
    {
      "source": "/api/entitati/",
      "destination": "/data/entitati.json"
    },
    {
      "source": "/api/pages",
      "destination": "/data/pages.json"
    },
    {
      "source": "/api/pages/",
      "destination": "/data/pages.json"
    },
    {
      "source": "/api/site-health",
      "destination": "/data/site-health.json"
    },
    {
      "source": "/api/site-health/",
      "destination": "/data/site-health.json"
    },
    {
      "source": "/api/structura",
      "destination": "/data/structura.json"
    },
    {
      "source": "/api/structura/",
      "destination": "/data/structura.json"
    },
    {
      "source": "/api/leads",
      "destination": "/data/leads-public.json"
    },
    {
      "source": "/api/leads/",
      "destination": "/data/leads-public.json"
    },
    {
      "source": "/manage",
      "destination": "/manage/index.html"
    },
    {
      "source": "/manage/",
      "destination": "/manage/index.html"
    },
    {
      "source": "/manage/:path*/",
      "destination": "/manage/index.html"
    },
    {
      "source": "/manage/:path*",
      "destination": "/manage/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "moaclinic.ro"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(manage|api|data)/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/nou/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(nou/media|entitati/media|wp-content/uploads)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/nou/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/nou/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/nou/style.min.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
