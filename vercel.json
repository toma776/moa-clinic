{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-homepage.js && node scripts/perf.js",
  "outputDirectory": ".",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "data/{preturi,brand,intrebari-status,observatii-status}.json"
    }
  },
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/manage/legaturi",
      "destination": "/manage/sinapse",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/nou/index.html"
    },
    {
      "source": "/vechi",
      "destination": "/site/index.html"
    },
    {
      "source": "/wp-content/:path*",
      "destination": "/site/wp-content/:path*"
    },
    {
      "source": "/wp-includes/:path*",
      "destination": "/site/wp-includes/:path*"
    },
    {
      "source": "/nou",
      "destination": "/nou/index.html"
    },
    {
      "source": "/nou/medici/:id",
      "destination": "/nou/medici/:id/index.html"
    },
    {
      "source": "/nou/tratamente/:cat/:id",
      "destination": "/nou/tratamente/:cat/:id/index.html"
    },
    {
      "source": "/nou/consultatii",
      "destination": "/nou/consultatii/index.html"
    },
    {
      "source": "/nou/consultatii/:id",
      "destination": "/nou/consultatii/:id/index.html"
    },
    {
      "source": "/nou/preturi",
      "destination": "/nou/preturi/index.html"
    },
    {
      "source": "/nou/video",
      "destination": "/nou/video/index.html"
    },
    {
      "source": "/nou/blog",
      "destination": "/nou/blog/index.html"
    },
    {
      "source": "/nou/longevitate/program",
      "destination": "/nou/longevitate/program/index.html"
    },
    {
      "source": "/nou/:slug",
      "destination": "/nou/:slug/index.html"
    },
    {
      "source": "/api/entitati",
      "destination": "/data/entitati.json"
    },
    {
      "source": "/api/pages",
      "destination": "/data/pages.json"
    },
    {
      "source": "/api/site-health",
      "destination": "/data/site-health.json"
    },
    {
      "source": "/api/structura",
      "destination": "/data/structura.json"
    },
    {
      "source": "/api/leads",
      "destination": "/data/leads-public.json"
    },
    {
      "source": "/manage",
      "destination": "/manage/index.html"
    },
    {
      "source": "/manage/:path*",
      "destination": "/manage/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/nou/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/nou/style.min.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
